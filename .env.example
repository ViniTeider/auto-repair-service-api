# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=repair_shop_db

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRATION=1d

# Admin Seed
ADMIN_DEFAULT_EMAIL=admin@repair-shop.com
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!