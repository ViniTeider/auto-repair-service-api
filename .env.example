# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=repair_shop_db

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
# Token lifetime: a duration such as 1d or 2h; a plain number means seconds
JWT_EXPIRATION=1d

# Admin login (required)
ADMIN_EMAIL=admin@repair-shop.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Public URL used in the budget email links
APP_PUBLIC_URL=http://localhost:3000

# Email (SMTP). When SMTP_HOST is empty, emails are generated but not delivered
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@repair-shop.com
